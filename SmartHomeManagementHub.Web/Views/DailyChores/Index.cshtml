@model List<SmartHomeManagementHub.Web.Models.DailyChores>

<h1>Daily Chores</h1>

<table>
    <thead>
        <tr>
            <th>Task</th>
            <th>Assigned To</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var chore in Model)
        {
            <tr>
                <td>@chore.Task</td>
                <td>@chore.AssignedPerson</td>
                <td>@chore.Status</td>
            </tr>
        }
    </tbody>
</table>